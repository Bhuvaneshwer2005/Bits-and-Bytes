# Copy to .env for local work. In production, set these in the host's environment settings.
# NEVER commit real keys: this repo is public.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults are set in api/_lib/providers.ts)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b

# Local testing only: returns a canned outline without calling any model. Never set in production.
# AI_MOCK=1
